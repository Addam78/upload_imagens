# Copie este arquivo para .env e troque os valores: cp .env.example .env

# Postgres (usado pelo docker-compose)
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=images
DATABASE_URL=postgresql://app:change-me@localhost:5433/images

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO (storage compatível com S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_BUCKET=images

# API
PORT=3333
MAX_UPLOAD_MB=20
